-- c2880689_anest.v_presupuestos_cab source

create or REPLACE algorithm = UNDEFINED view `c2880689_anest`.`v_presupuestos_cab` as
select
    `pc`.`id` as `id`,
    `pc`.`fecha` as `fecha`,
    `pc`.`nombre` as `nombre`,
    `pc`.`fecha_nac` as `fecha_nac`,
    `pc`.`dni` as `dni`,
    `pc`.`centro_id` as `centro_id`,
    `c`.`nombre` as `centro`,
    `pc`.`profesional_id` as `profesional_id`,
    `p`.`nombre` as `profesional`,
    `pc`.`observaciones` as `observaciones`,
    `pc`.`usuario_id` as `usuario_id`,
    `u`.`name` as `usuario`,
    `pc`.`valor_dolar` as `valor_dolar`,
    `pc`.`estado` as `estado_original`,
    `pc`.`parte_cab_id` as `parte_cab_id`,
    `pc`.`created_at` as `created_at`,
    `pc`.`updated_at` as `updated_at`,
    `pc`.`deleted_at` as `deleted_at`,
    `pc`.`gerenciadora_id` as `gerenciadora_id`,
    case
        when `pc`.`deleted_at` is not null then 'C'
        when `pc`.`parte_cab_id` is not null then 'F'
        when `pc`.`estado` = 'p' then 'P'
        when `pp`.`total_pagado` > 0 then 'O'
        else 'I'
    end collate utf8mb4_unicode_ci as `estado`,
    coalesce(`pp`.`total_pagado`, 0) as `total_pagado`,
    coalesce(`pd`.`total_presupuesto`, 0) as `total_presupuesto`
from
    (((((`c2880689_anest`.`presupuestos_cab` `pc`
left join `c2880689_anest`.`centros` `c` on
    (`c`.`id` = `pc`.`centro_id`))
left join `c2880689_anest`.`profesionales` `p` on
    (`p`.`id` = `pc`.`profesional_id`))
left join `c2880689_anest`.`users` `u` on
    (`u`.`id` = `pc`.`usuario_id`))
left join (
    select
        `c2880689_anest`.`presupuestos_pagos`.`presupuesto_cab_id` as `presupuesto_cab_id`,
        sum(`c2880689_anest`.`presupuestos_pagos`.`valor`) as `total_pagado`
    from
        `c2880689_anest`.`presupuestos_pagos`
    where
        `c2880689_anest`.`presupuestos_pagos`.`deleted_at` is null
    group by
        `c2880689_anest`.`presupuestos_pagos`.`presupuesto_cab_id`) `pp` on
    (`pp`.`presupuesto_cab_id` = `pc`.`id`))
left join (
    select
        `c2880689_anest`.`presupuestos_det`.`presupuesto_cab_id` as `presupuesto_cab_id`,
        sum(`c2880689_anest`.`presupuestos_det`.`valor`) as `total_presupuesto`
    from
        `c2880689_anest`.`presupuestos_det`
    where
        `c2880689_anest`.`presupuestos_det`.`deleted_at` is null
    group by
        `c2880689_anest`.`presupuestos_det`.`presupuesto_cab_id`) `pd` on
    (`pd`.`presupuesto_cab_id` = `pc`.`id`));

