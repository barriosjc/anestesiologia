-- c2880689_anest.v_consumos source

create or REPLACE algorithm = UNDEFINED view `c2880689_anest`.`v_consumos` as
select
    `cc`.`id` as `consumos_cab_id`,
    `cc`.`parte_cab_id` as `parte_cab_id`,
    `cd`.`estado_id` as `estado_id`,
    `cc`.`user_id` as `user_id`,
    `cc`.`created_at` as `created_at`,
    `cc`.`updated_at` as `updated_at`,
    `cc`.`deleted_at` as `deleted_at`,
    `cd`.`id` as `id`,
    `cd`.`nomenclador_id` as `nomenclador_id`,
    `cd`.`porcentaje` as `porcentaje`,
    `cd`.`cantidad` as `cantidad`,
    `cd`.`valor` as `valor`,
    `cd`.`obs_refac` as `observaciones`,
    `np`.`codigo` as `codigo`,
    `np`.`nivel` as `nivel`,
    `np`.`descripcion` as `nom_descripcion`,
    `e`.`descripcion` as `est_descripcion`
from
    (((`c2880689_anest`.`consumos_cab` `cc`
join `c2880689_anest`.`consumos_det` `cd` on
    (`cc`.`id` = `cd`.`consumo_cab_id`))
join `c2880689_anest`.`estados` `e` on
    (`e`.`id` = `cd`.`estado_id`))
join (
    select
        `n`.`id` as `id`,
        `n`.`nom_padre_id` as `nom_padre_id`,
        `n`.`codigo` as `codigo`,
        `n`.`nivel` as `nivel`,
        `n`.`descripcion` as `descripcion`
    from
        `c2880689_anest`.`nomenclador` `n`
union all
    select
        `p`.`id` as `id`,
        `p`.`nom_padre_id` as `nom_padre_id`,
        `p`.`codigo` as `codigo`,
        `p`.`codigo` as `codigo`,
        `p`.`nombre` as `nombre`
    from
        `c2880689_anest`.`nom_practicas_estudios` `p`) `np` on
    (`np`.`id` = `cd`.`nomenclador_id`))
where
    `cc`.`deleted_at` is null
    and `cd`.`deleted_at` is null;

