-- c2880689_anest.v_rendicion_agrupxnivel source

create or REPLACE algorithm = UNDEFINED view `c2880689_anest`.`v_rendicion_agrupxnivel` as
select
    `con`.`parte_cab_id` as `parte_cab_id`,
    `con`.`cantidad` as `cantidad`,
    `con`.`periodo` as `periodo`,
    `con`.`niveles` as `niveles`,
    `con`.`valor` as `valor`,
    `pc`.`id` as `id`,
    `pc`.`profesional_id` as `profesional_id`,
    `pc`.`paciente_id` as `paciente_id`,
    `pc`.`cobertura_id` as `cobertura_id`,
    `pc`.`centro_id` as `centro_id`,
    `pc`.`fec_prestacion` as `fec_prestacion_orig`,
    date_format(`pc`.`fec_prestacion`, '%d/%m/%Y') as `fec_prestacion`,
    `pc`.`user_id` as `user_id`,
    `pc`.`observaciones` as `observaciones`,
    `pc`.`estado_id` as `estado_id`,
    `pc`.`created_at` as `created_at`,
    `pc`.`updated_at` as `updated_at`,
    `pc`.`deleted_at` as `deleted_at`,
    `pr`.`nombre` as `prof_nombre`,
    concat(`pa`.`dni`, '/', `pa`.`nombre`, ' (', timestampdiff(year, `pa`.`fec_nacimiento`, curdate()), ')') as `pac_nombre`,
    `co`.`nombre` as `cob_nombre`,
    `co`.`sigla` as `cob_sigla`,
    `ce`.`nombre` as `cen_nombre`
from
    ((((((
    select
        `cc`.`parte_cab_id` as `parte_cab_id`,
        `cd`.`cantidad` as `cantidad`,
        `cd`.`periodo` as `periodo`,
        group_concat(coalesce(`n`.`nivel`, `np`.`codigo`) order by coalesce(`n`.`nivel`, `np`.`codigo`) asc separator ', ') as `niveles`,
        sum(`cd`.`valor`) as `valor`
    from
        (((`c2880689_anest`.`consumos_det` `cd`
    join `c2880689_anest`.`consumos_cab` `cc` on
        (`cc`.`id` = `cd`.`consumo_cab_id`))
    left join `c2880689_anest`.`nomenclador` `n` on
        (`cd`.`nomenclador_id` = `n`.`id` and `cd`.`nom_padre_id` = `n`.`nom_padre_id`))
    left join `c2880689_anest`.`nom_practicas_estudios` `np` on
        (`cd`.`nomenclador_id` = `np`.`id` and `cd`.`nom_padre_id` = `np`.`nom_padre_id`))
    where
        `cd`.`deleted_at` is null
    group by
        `cd`.`consumo_cab_id`,
        `cd`.`cantidad`,
        `cd`.`periodo`) `con`
join `c2880689_anest`.`partes_cab` `pc` on
    (`pc`.`id` = `con`.`parte_cab_id`))
join `c2880689_anest`.`profesionales` `pr` on
    (`pr`.`id` = `pc`.`profesional_id`))
join `c2880689_anest`.`pacientes` `pa` on
    (`pa`.`id` = `pc`.`paciente_id`))
join `c2880689_anest`.`coberturas` `co` on
    (`co`.`id` = `pc`.`cobertura_id`))
join `c2880689_anest`.`centros` `ce` on
    (`ce`.`id` = `pc`.`centro_id`))
where
    `pc`.`deleted_at` is null;

