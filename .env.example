APP_NAME=SAADA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anestesiologia
DB_USERNAME=administrativo
DB_PASSWORD=anestesia

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# LlamaParse (PDF -> XLSX -> JSON por HTTP, sin binarios)
LLAMAPARSE_API_KEY=
LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai/api/v2
LLAMAPARSE_TIER=agentic
LLAMAPARSE_VERSION=latest
LLAMAPARSE_MAX_FILE_MB=100
LLAMAPARSE_IDIOMAS=es,en
LLAMAPARSE_TABLES_AS_SPREADSHEET=true
LLAMAPARSE_ATENCIONES_ESPERADAS=
LLAMAPARSE_CORREGIR_17_A_11=true
LLAMAPARSE_RUTA=llamaparse
LLAMAPARSE_TIMEOUT_SUBIDA=180
LLAMAPARSE_TIMEOUT_CONSULTA=30
LLAMAPARSE_TIMEOUT_DESCARGA=60
LLAMAPARSE_VERIFY_SSL=true
